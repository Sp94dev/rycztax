{
  "name": "@rycztax/source",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ng": "ng",
    "start:app": "npm run start -w @rycztax/app",
    "start:emulators": "npm run start -w @rycztax/firebase",
    "start:dev": "npm-run-all --parallel start -w @rycztax/app\" \"emulators:start -w @rycztax/firebase\"",
    "build": "npm run build -w @rycztax/app",
    "watch": "npm run watch -w @rycztax/app",
    "test": "npm run test -w @rycztax/app"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/fire": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@primeng/themes": "^19.1.3",
    "@tailwindcss/postcss": "^4.1.7",
    "canvas": "^3.1.2",
    "firebase-functions": "^6.4.0",
    "jspdf": "^3.0.1",
    "pdfjs-dist": "^5.3.93",
    "postcss": "^8.5.3",
    "primeng": "^19.1.3",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.7",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.13",
    "@angular/cli": "^19.2.13",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "firebase-tools": "^13.35.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.7.2"
  }
}
